[Unit]
Description=Embeddings API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=embeddings
Group=embeddings
WorkingDirectory=/opt/embeddings-api
Environment=NODE_ENV=production
EnvironmentFile=/etc/embeddings-api.env
ExecStart=/usr/bin/node /opt/embeddings-api/src/server.js
Restart=on-failure
RestartSec=2

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/embeddings-api

# Reasonable limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
