rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function normalizedEmail() {
      return isSignedIn() && (request.auth.token.email is string)
        ? request.auth.token.email
        : '';
    }

    function isAdmin() {
      // Use a custom claim `admin` set on the user's ID token via Admin SDK.
      return isSignedIn() && request.auth.token.admin == true;
    }

    function adminRoleValues() {
      return ['admin', 'Admin', 'ADMIN'];
    }

    function instructorRoleValues() {
      return ['instructor', 'Instructor', 'INSTRUCTOR'];
    }

    function studentRoleValues() {
      return ['student', 'Student', 'STUDENT'];
    }

    function allowedUserRoleValues() {
      return ['instructor', 'Instructor', 'INSTRUCTOR', 'student', 'Student', 'STUDENT'];
    }

    function roleMatches(role, allowed) {
      return role is string && role in allowed;
    }

    function roleFromData(data) {
      return data is map && data.role is string ? data.role : null;
    }

    function userDoc(uid) {
      return uid is string && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid))
        : null;
    }

    function userRole(uid) {
      let snapshot = userDoc(uid);
      return snapshot == null ? null : roleFromData(snapshot.data);
    }

    function currentRole() {
      return isSignedIn() ? userRole(request.auth.uid) : null;
    }

    function isInstructor() {
      return roleMatches(currentRole(), instructorRoleValues());
    }

    function isApprovedInstructor() {
      let snapshot = userDoc(request.auth.uid);
      return isInstructor() && snapshot != null && snapshot.data.approved == true;
    }

    function isStudent() {
      return roleMatches(currentRole(), studentRoleValues());
    }

    function currentUserSection() {
      let snapshot = userDoc(request.auth.uid);
      return snapshot != null && snapshot.data.section is string
        ? snapshot.data.section
        : '';
    }

    function attendanceSessionDoc(sessionId) {
      return sessionId is string && exists(/databases/$(database)/documents/attendanceSessions/$(sessionId))
        ? get(/databases/$(database)/documents/attendanceSessions/$(sessionId))
        : null;
    }

    function attendanceSessionSection(sessionId) {
      let snapshot = attendanceSessionDoc(sessionId);
      return snapshot != null && snapshot.data.section is string
        ? snapshot.data.section
        : '';
    }

    function isRoleAdmin() {
      return roleMatches(currentRole(), adminRoleValues());
    }

    function canViewCatalog() {
      return isAdmin() || isRoleAdmin() || isApprovedInstructor() || isStudent();
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function nonEmptyStringList(data, field) {
      return (field in data) && (data[field] is list) && data[field].size() > 0;
    }

    function departmentDoc(deptId) {
      return deptId is string && exists(/databases/$(database)/documents/departments/$(deptId))
        ? get(/databases/$(database)/documents/departments/$(deptId))
        : null;
    }

    function subjectDoc(subjectId) {
      return subjectId is string && exists(/databases/$(database)/documents/subjects/$(subjectId))
        ? get(/databases/$(database)/documents/subjects/$(subjectId))
        : null;
    }

    function classDoc(classId) {
      return classId is string && exists(/databases/$(database)/documents/classes/$(classId))
        ? get(/databases/$(database)/documents/classes/$(classId))
        : null;
    }

    function isClassInstructor(classId) {
      let doc = classDoc(classId);
      return doc != null && doc.data.instructorId == request.auth.uid;
    }

    function subjectDepartmentMatches(deptId, deptName) {
      let dept = departmentDoc(deptId);
      return dept != null && dept.data.name == deptName;
    }

    function classSubjectMatches(subjectId, subjectCode, subjectName, departmentName) {
      let subject = subjectDoc(subjectId);
      return subject != null &&
             subject.data.subjectCode == subjectCode &&
             subject.data.subjectName == subjectName &&
             subject.data.departmentName == departmentName;
    }

    function assignedInstructorIsValid(instructorId) {
      let doc = userDoc(instructorId);
      return doc != null && roleMatches(roleFromData(doc.data), instructorRoleValues());
    }

    function isValidDepartment(data) {
      return nonEmptyString(data.name) &&
             optionalString(data, 'abbr') &&
             (!('isActive' in data) || data.isActive is bool) &&
             optionalTimestamp(data, 'createdAt') &&
             optionalTimestamp(data, 'updatedAt');
    }

    function isValidSubject(data) {
      return nonEmptyString(data.subjectCode) &&
             nonEmptyString(data.subjectName) &&
             nonEmptyString(data.departmentId) &&
             nonEmptyString(data.departmentName) &&
             nonEmptyStringList(data, 'sections') &&
             nonEmptyStringList(data, 'terms') &&
             data.isActive is bool &&
             optionalTimestamp(data, 'createdAt') &&
             optionalTimestamp(data, 'updatedAt') &&
             subjectDepartmentMatches(data.departmentId, data.departmentName);
    }

    function isValidClass(data) {
      return nonEmptyString(data.subjectId) &&
             nonEmptyString(data.subjectCode) &&
             nonEmptyString(data.subjectName) &&
             nonEmptyString(data.departmentName) &&
             nonEmptyString(data.section) &&
             nonEmptyString(data.term) &&
             nonEmptyString(data.instructorId) &&
             (data.schedules is list) && data.schedules.size() > 0 &&
             data.hasLab is bool &&
             optionalTimestamp(data, 'createdAt') &&
             optionalTimestamp(data, 'updatedAt') &&
             classSubjectMatches(
               data.subjectId,
               data.subjectCode,
               data.subjectName,
               data.departmentName
             ) &&
             assignedInstructorIsValid(data.instructorId);
    }

    function isValidAttendanceReportTemplate(data) {
      return data is map &&
        request.resource.data.keys().hasOnly([
          'documentCodeNo',
          'revisionNo',
          'effectiveDate',
          'updatedAt'
        ]) &&
        optionalString(data, 'documentCodeNo') &&
        optionalString(data, 'revisionNo') &&
        optionalString(data, 'effectiveDate') &&
        optionalTimestamp(data, 'updatedAt');
    }

    match /users/{userId} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == userId;
      }

      function touchesFaceEmbeddingFields() {
        return request.writeFields.hasAny([
          'faceEmbed',
          'faceEmbeds',
          'faceEmbedCount',
          'faceEmbedProvider',
          'faceEmbedUpdatedAt'
        ]);
      }

      function unchanged(field) {
        return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
      }

      function validOwnerUpdate() {
        let existingRole = roleFromData(resource.data);
        let newRole = roleFromData(request.resource.data);
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return isOwner() &&
          (
            // Normal case: role is already set; users cannot change it.
            (existingRole != null && roleMatches(newRole, [existingRole])) ||
            // Repair case: legacy users missing a role may set it once.
            (existingRole == null &&
              changed.hasOnly(['role']) &&
              roleMatches(newRole, allowedUserRoleValues()))
          ) &&
          // Prevent self-approval / admin-only changes.
          unchanged('approved') &&
          unchanged('approvedAt') &&
          unchanged('approvedBy') &&
          // Student ID is immutable after initial claim; changes must go through admin flow.
          unchanged('studentId') &&
          unchanged('Student ID');
      }

      allow create: if ((
        isOwner() &&
        request.resource.data.role in allowedUserRoleValues() &&
        nonEmptyString(request.resource.data['Full Name']) &&
        nonEmptyString(request.resource.data.Email) &&
        // Do not allow users to create themselves as approved.
        (!('approved' in request.resource.data) || request.resource.data.approved == false)
      ) || isAdmin()) && !touchesFaceEmbeddingFields();

      allow read: if isOwner() || isAdmin() || isRoleAdmin() || isInstructor();

      allow update: if (isAdmin() || validOwnerUpdate()) && !touchesFaceEmbeddingFields();

      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner();
        // Notifications are written by Cloud Functions (Admin SDK).
        allow create, delete: if false;
        // Allow the owner to mark notifications as read.
        allow update: if isOwner() &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt']) &&
          (!("readAt" in request.resource.data) || request.resource.data.readAt is timestamp);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner();
        // Token docs are managed by the owner client.
        allow create, update: if isOwner() &&
          request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'updatedAt', 'lastSeenAt']) &&
          request.resource.data.token == tokenId &&
          optionalString(request.resource.data, 'platform') &&
          optionalTimestamp(request.resource.data, 'createdAt') &&
          optionalTimestamp(request.resource.data, 'updatedAt') &&
          optionalTimestamp(request.resource.data, 'lastSeenAt');
        allow delete: if isOwner();
      }
    }

    match /departments/{deptId} {
      allow read: if canViewCatalog();
      allow create, update: if isAdmin() && isValidDepartment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if canViewCatalog() || request.auth == null;
      allow create, update: if isAdmin() && isValidSubject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if canViewCatalog();
      allow create, update: if isAdmin() && isValidClass(request.resource.data);
      allow delete: if isAdmin();

      match /attendanceStats/{studentId} {
        allow read: if isSignedIn() && (request.auth.uid == studentId || isClassInstructor(classId) || isAdmin());
        allow write: if isAdmin() || (isSignedIn() && isClassInstructor(classId) && isApprovedInstructor());
      }

      match /attendanceOverrides/{overrideId} {
        allow read: if isSignedIn() && (isAdmin() || isRoleAdmin() || isClassInstructor(classId) || isStudent());
        // Overrides are applied via Cloud Functions (Admin SDK). Allowing direct client writes
        // increases risk of tampering, so keep it locked down.
        allow create, update, delete: if isAdmin();
      }
    }

    match /excuseRequests/{requestId} {
      function isOwner() {
        return isSignedIn() && resource.data.studentId == request.auth.uid;
      }

      function isAssignedInstructor() {
        return isSignedIn() && (resource.data.instructorIds is list) && request.auth.uid in resource.data.instructorIds;
      }

      function studentAttachmentOnlyUpdate() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return isStudent() &&
          isOwner() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'pending' &&
          changed.hasOnly(['attachment', 'updatedAt']);
      }

      allow read: if isAdmin() || isRoleAdmin() || isApprovedInstructor() || isOwner() || isAssignedInstructor();

      // Create/approve flows are handled through Cloud Functions (Admin SDK). This prevents
      // clients from spoofing instructor routing or approval fields.
      allow create: if false;

      // Students can only attach/update attachment metadata while pending.
      allow update: if isAdmin() || studentAttachmentOnlyUpdate();

      // Only admin (custom claim) can delete requests.
      allow delete: if isAdmin();
    }

    match /attendanceSessions/{sessionId} {
      // Instructors/admin create + update sessions.
      allow create, update: if isSignedIn() && (isApprovedInstructor() || isAdmin());

      // Students can read session docs for their own section.
      allow read: if isSignedIn() && (
        isApprovedInstructor() ||
        isAdmin() ||
        isRoleAdmin() ||
        (isStudent() && currentUserSection() != '' && resource.data.section == currentUserSection())
      );
      allow delete: if isAdmin();

      // Students may only read their own attendee record, and only when the
      // session is in their section.
      match /attendees/{studentId} {
        allow read: if isSignedIn() && (
          isApprovedInstructor() ||
          isAdmin() ||
          isRoleAdmin() ||
          (isStudent() && request.auth.uid == studentId && currentUserSection() != '' && attendanceSessionSection(sessionId) == currentUserSection())
        );
        allow write: if isSignedIn() && (isApprovedInstructor() || isAdmin());
      }

      // Keep raw captures private to instructors/admin.
      match /captures/{captureId} {
        allow read, write: if isSignedIn() && (isApprovedInstructor() || isAdmin());
      }

      match /{subcollection=**}/{docId} {
        allow read, write: if isSignedIn() && (isApprovedInstructor() || isAdmin());
      }
    }

    match /alerts/{alertId} {
      allow read: if isAdmin() || isRoleAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Global per-day attendance calendar overrides (Holiday / Suspension / Exam Week).
    // Doc IDs are YYYY-MM-DD.
    match /attendanceCalendarDays/{dateKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isRoleAdmin();
    }

    // App-level settings (small, controlled documents).
    match /settings/{settingId} {
      // Template meta is used in report generation (instructor + admin).
      // Keep this readable for any signed-in user to avoid report generation
      // failures if role/approval state is still being configured.
      allow read: if settingId == 'attendanceReportTemplate' && isSignedIn();

      // Only true admins (custom claim) can edit settings.
      allow create, update: if settingId == 'attendanceReportTemplate' &&
        isAdmin() && isValidAttendanceReportTemplate(request.resource.data);

      allow delete: if false;
    }

    // Unique Student ID index.
    // Each document ID is the normalized Student ID and stores the owning uid.
    match /studentIdIndex/{studentId} {
      // Keep index mostly private.
      allow read: if isAdmin() || isRoleAdmin();

      // Students can claim an ID for themselves as part of signup.
      // Uses existsAfter/getAfter so a batched/transactional write that also
      // creates/updates the user's profile can pass validation.
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.studentId == studentId &&
        !exists(/databases/$(database)/documents/studentIdIndex/$(studentId)) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        roleMatches(
          roleFromData(
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data
          ),
          studentRoleValues()
        );

      // Admins can manage the index when fixing profiles.
      allow create, update, delete: if isAdmin() || isRoleAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
