{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "simple-distributed-database",
          "appId": "1:424296832329:android:f85602b9ccbf951ce64e98",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "simple-distributed-database",
          "configurations": {
            "android": "1:424296832329:android:f85602b9ccbf951ce64e98",
            "ios": "1:424296832329:ios:dc3bbf3d931bf1cfe64e98",
            "macos": "1:424296832329:ios:dc3bbf3d931bf1cfe64e98",
            "web": "1:424296832329:web:abbcff50e61c5ffce64e98",
            "windows": "1:424296832329:web:f5b861176f40a44be64e98"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      ".firebase/**",
      ".git/**",
      ".gitignore",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/reset",
        "destination": "/app/index.html"
      },
      {
        "source": "/reset/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/app",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "headers": [
      {
        "source": "/downloads/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/downloads/app-latest.apk",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/downloads/app-latest-*.apk",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
